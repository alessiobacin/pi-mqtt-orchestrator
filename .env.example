# Evolution API / WhatsApp
# ATTENZIONE (Revisione 48 — bug reale trovato in un progetto reale che usa
# questo pacchetto): la chiave qui sotto DEVE chiamarsi EVOLUTION_INSTANCE_NAME
# (con "_NAME"), non solo EVOLUTION_INSTANCE — extensions/orchestrator.ts
# legge esattamente EVOLUTION_INSTANCE_NAME (vedi sendWhatsAppNotification());
# un .env con solo EVOLUTION_INSTANCE non attiva mai le notifiche, in silenzio.
# Servono TUTTE E QUATTRO le chiavi sotto — se anche una sola manca (capitato
# per davvero: DESTINATION_PHONE_NUMBER dimenticata in un progetto reale) ogni
# invio fallisce con "non configurato — variabili mancanti nel .env: <nome>",
# visibile nei log/report ma altrimenti silenzioso.
EVOLUTION_API_URL=<your_api_url>
EVOLUTION_API_KEY=<your_api_key>
EVOLUTION_INSTANCE_NAME=<your_instance_name>
DESTINATION_PHONE_NUMBER=<your_destination_phone_number>